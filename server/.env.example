PORT=5000
CLIENT_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/catalysthub
# Guest demo uses a separate database and API port. Never point this at MONGODB_URI.
MONGODB_GUEST_URI=mongodb://127.0.0.1:27017/catalysthub_guest
GUEST_PORT=5001
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
# Gmail account used to send verification emails. Use a Google app password, not your account password.
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=your-16-character-app-password
# Use a separate long random secret for signing email verification codes.
EMAIL_OTP_SECRET=replace-with-a-different-long-random-secret
