PORT=5000
CLIENT_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/catalysthub
# Guest demo uses a separate database and API port. Never point this at MONGODB_URI.
MONGODB_GUEST_URI=mongodb://127.0.0.1:27017/catalysthub_guest
GUEST_PORT=5001
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
# Required for real-email account verification. Resend sender must be verified.
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=CatalystHub <no-reply@your-verified-domain.com>
# Use a separate long random secret; falls back to JWT_SECRET when omitted.
EMAIL_OTP_SECRET=replace-with-a-different-long-random-secret
