{
  "name": "catalysthub-server",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:guest": "tsx watch src/guestIndex.ts",
    "build": "tsc",
    "test": "tsx --test src/services/notificationScope.test.ts src/services/activityPrivacy.test.ts src/services/attachmentValidation.test.ts src/services/ticketPolicy.test.ts src/services/messageContracts.test.ts src/middleware/errors.test.ts",
    "test:integration": "node --env-file=.env.test --import tsx --test src/integration.test.ts",
    "seed:preview": "node --env-file=.env.test --import tsx src/scripts/previewData.ts seed",
    "reset:preview": "node --env-file=.env.test --import tsx src/scripts/previewData.ts reset",
    "start": "node dist/index.js",
    "start:guest": "node dist/guestIndex.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "nodemailer": "^10.1.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
